import AppKit
import Foundation

let projectRoot = __PROJECT_ROOT__
let logPath = "/tmp/work-journal-agent-menubar.log"

struct CommandResult {
    let status: Int32
    let stdout: String
    let stderr: String

    var ok: Bool { status == 0 }
    var message: String {
        let text = ok ? stdout : stderr
        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
        return trimmed.isEmpty ? "exit \(status)" : trimmed
    }
}

func todayString() -> String {
    let formatter = DateFormatter()
    formatter.dateFormat = "yyyy-MM-dd"
    return formatter.string(from: Date())
}

func shellQuote(_ value: String) -> String {
    return "'" + value.replacingOccurrences(of: "'", with: "'\\''") + "'"
}

func appendLog(_ text: String) {
    let line = "[\(Date())] \(text)\n"
    if let data = line.data(using: .utf8) {
        if FileManager.default.fileExists(atPath: logPath),
           let handle = try? FileHandle(forWritingTo: URL(fileURLWithPath: logPath)) {
            handle.seekToEndOfFile()
            handle.write(data)
            try? handle.close()
        } else {
            try? data.write(to: URL(fileURLWithPath: logPath))
        }
    }
}

func runWJ(_ arguments: [String], input: String? = nil) -> CommandResult {
    let args = arguments.map(shellQuote).joined(separator: " ")
    let command = "cd \(shellQuote(projectRoot)) && if [ -f ~/.config/work-journal-agent/secrets.env ]; then source ~/.config/work-journal-agent/secrets.env; fi; PYTHONPATH=src python3 -m work_journal_agent \(args)"
    appendLog("$ \(command)")

    let process = Process()
    process.executableURL = URL(fileURLWithPath: "/bin/zsh")
    process.arguments = ["-lc", command]

    let stdout = Pipe()
    let stderr = Pipe()
    let stdin = Pipe()
    process.standardOutput = stdout
    process.standardError = stderr
    if input != nil {
        process.standardInput = stdin
    }

    do {
        try process.run()
        if let input, let data = input.data(using: .utf8) {
            stdin.fileHandleForWriting.write(data)
            try? stdin.fileHandleForWriting.close()
        }
        process.waitUntilExit()
    } catch {
        appendLog("failed: \(error.localizedDescription)")
        return CommandResult(status: 127, stdout: "", stderr: error.localizedDescription)
    }

    let out = String(data: stdout.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? ""
    let err = String(data: stderr.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? ""
    if !err.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
        appendLog(err)
    }
    return CommandResult(status: process.terminationStatus, stdout: out, stderr: err)
}

func runWJAsync(_ arguments: [String], input: String? = nil, completion: @escaping (CommandResult) -> Void) {
    DispatchQueue.global(qos: .userInitiated).async {
        let result = runWJ(arguments, input: input)
        DispatchQueue.main.async {
            completion(result)
        }
    }
}

func parseObject(_ text: String) throws -> [String: Any] {
    let data = Data(text.utf8)
    let value = try JSONSerialization.jsonObject(with: data)
    guard let object = value as? [String: Any] else {
        throw NSError(domain: "WorkJournal", code: 1, userInfo: [NSLocalizedDescriptionKey: "JSON root is not an object"])
    }
    return object
}

func jsonString(_ object: [String: Any]) throws -> String {
    let data = try JSONSerialization.data(withJSONObject: object)
    return String(data: data, encoding: .utf8) ?? "{}"
}

func text(_ value: Any?) -> String {
    if let string = value as? String { return string }
    if let number = value as? NSNumber { return number.stringValue }
    return ""
}

func bool(_ value: Any?) -> Bool {
    if let value = value as? Bool { return value }
    if let number = value as? NSNumber { return number.boolValue }
    return false
}

func bool(_ value: Any?, default defaultValue: Bool) -> Bool {
    if let value = value as? Bool { return value }
    if let number = value as? NSNumber { return number.boolValue }
    return defaultValue
}

func int(_ value: Any?, default defaultValue: Int) -> Int {
    if let number = value as? NSNumber { return number.intValue }
    if let string = value as? String, let parsed = Int(string) { return parsed }
    return defaultValue
}

func object(_ value: Any?) -> [String: Any] {
    return value as? [String: Any] ?? [:]
}

func list(_ value: Any?) -> [Any] {
    return value as? [Any] ?? []
}

func makeLabel(_ value: String, weight: NSFont.Weight = .regular) -> NSTextField {
    let label = NSTextField(labelWithString: value)
    label.font = NSFont.systemFont(ofSize: 13, weight: weight)
    label.lineBreakMode = .byTruncatingTail
    return label
}

func makeField(_ value: String = "") -> NSTextField {
    let field = NSTextField(string: value)
    field.font = NSFont.systemFont(ofSize: 13)
    field.lineBreakMode = .byTruncatingTail
    return field
}

func attachDocumentView(_ documentView: NSView, to scrollView: NSScrollView) {
    documentView.translatesAutoresizingMaskIntoConstraints = false
    scrollView.documentView = documentView
    NSLayoutConstraint.activate([
        documentView.leadingAnchor.constraint(equalTo: scrollView.contentView.leadingAnchor),
        documentView.trailingAnchor.constraint(equalTo: scrollView.contentView.trailingAnchor),
        documentView.topAnchor.constraint(equalTo: scrollView.contentView.topAnchor),
        documentView.bottomAnchor.constraint(greaterThanOrEqualTo: scrollView.contentView.bottomAnchor),
        documentView.widthAnchor.constraint(equalTo: scrollView.contentView.widthAnchor)
    ])
}

func showAlert(title: String, message: String) {
    let alert = NSAlert()
    alert.messageText = title
    alert.informativeText = message
    alert.alertStyle = .informational
    alert.addButton(withTitle: "OK")
    alert.runModal()
}

final class AppDelegate: NSObject, NSApplicationDelegate {
    private var statusItem: NSStatusItem!
    private var reviewWindow: ReviewWindowController?
    private var settingsWindow: SettingsWindowController?

    func applicationDidFinishLaunching(_ notification: Notification) {
        statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
        statusItem.button?.title = "WJ"
        rebuildMenu()
        refreshStatus()
    }

    private func rebuildMenu() {
        let menu = NSMenu()
        menu.addItem(NSMenuItem(title: "Work Journal", action: nil, keyEquivalent: ""))
        menu.addItem(NSMenuItem.separator())
        menu.addItem(item("今日需求确认...", #selector(openReview)))
        menu.addItem(item("同步最新事件", #selector(syncNow)))
        menu.addItem(item("生成今日日报", #selector(generateDaily)))
        menu.addItem(NSMenuItem.separator())
        menu.addItem(item("设置...", #selector(openSettings)))
        menu.addItem(item("打开本地数据目录", #selector(openDataDir)))
        menu.addItem(item("打开日志", #selector(openLog)))
        menu.addItem(NSMenuItem.separator())
        menu.addItem(item("退出", #selector(quit)))
        statusItem.menu = menu
    }

    private func item(_ title: String, _ selector: Selector) -> NSMenuItem {
        let item = NSMenuItem(title: title, action: selector, keyEquivalent: "")
        item.target = self
        return item
    }

    private func refreshStatus() {
        runWJAsync(["app", "status"]) { [weak self] result in
            guard let self else { return }
            guard result.ok, let payload = try? parseObject(result.stdout) else {
                self.statusItem.button?.title = "WJ !"
                return
            }
            let status = object(payload["status"])
            let pending = int(status["pending_requirements"], default: 0)
            self.statusItem.button?.title = pending > 0 ? "WJ · \(pending)" : "WJ"
        }
    }

    @objc private func openReview() {
        if reviewWindow == nil {
            reviewWindow = ReviewWindowController(onSaved: { [weak self] in self?.refreshStatus() })
        }
        reviewWindow?.show()
    }

    @objc private func openSettings() {
        if settingsWindow == nil {
            settingsWindow = SettingsWindowController()
        }
        settingsWindow?.show()
    }

    @objc private func syncNow() {
        statusItem.button?.title = "WJ ..."
        runWJAsync(["sync"]) { [weak self] result in
            self?.refreshStatus()
            showAlert(title: result.ok ? "同步完成" : "同步失败", message: result.message)
        }
    }

    @objc private func generateDaily() {
        statusItem.button?.title = "WJ ..."
        runWJAsync(["generate-daily"]) { [weak self] result in
            self?.refreshStatus()
            showAlert(title: result.ok ? "日报已生成" : "生成失败", message: result.message)
        }
    }

    @objc private func openDataDir() {
        NSWorkspace.shared.open(URL(fileURLWithPath: NSString(string: "~/.local/share/work-journal-agent").expandingTildeInPath))
    }

    @objc private func openLog() {
        let url = URL(fileURLWithPath: logPath)
        if !FileManager.default.fileExists(atPath: logPath) {
            try? "".write(to: url, atomically: true, encoding: .utf8)
        }
        NSWorkspace.shared.open(url)
    }

    @objc private func quit() {
        NSApp.terminate(nil)
    }
}

final class ReviewWindowController: NSWindowController {
    private let day = todayString()
    private let onSaved: () -> Void
    private let summaryLabel = makeLabel("加载中...")
    private let stack = NSStackView()
    private var cards: [ReviewCardView] = []

    init(onSaved: @escaping () -> Void) {
        self.onSaved = onSaved
        let window = NSWindow(
            contentRect: NSRect(x: 0, y: 0, width: 780, height: 660),
            styleMask: [.titled, .closable, .resizable],
            backing: .buffered,
            defer: false
        )
        window.title = "需求确认"
        super.init(window: window)
        build()
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }

    func show() {
        window?.center()
        window?.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        load()
    }

    private func build() {
        guard let content = window?.contentView else { return }
        let root = NSStackView()
        root.orientation = .vertical
        root.spacing = 12
        root.translatesAutoresizingMaskIntoConstraints = false
        content.addSubview(root)

        let header = NSStackView()
        header.orientation = .horizontal
        header.alignment = .centerY
        header.spacing = 10
        let title = makeLabel("今日需求确认 · \(day)", weight: .semibold)
        let spacer = NSView()
        let refresh = NSButton(title: "刷新", target: self, action: #selector(refreshTapped))
        let save = NSButton(title: "保存确认", target: self, action: #selector(saveTapped))
        save.bezelStyle = .rounded
        header.addArrangedSubview(title)
        header.addArrangedSubview(spacer)
        header.addArrangedSubview(refresh)
        header.addArrangedSubview(save)
        root.addArrangedSubview(header)
        root.addArrangedSubview(summaryLabel)

        let scroll = NSScrollView()
        scroll.hasVerticalScroller = true
        scroll.borderType = .noBorder
        stack.orientation = .vertical
        stack.spacing = 10
        stack.edgeInsets = NSEdgeInsets(top: 4, left: 2, bottom: 12, right: 8)
        attachDocumentView(stack, to: scroll)
        root.addArrangedSubview(scroll)

        NSLayoutConstraint.activate([
            root.leadingAnchor.constraint(equalTo: content.leadingAnchor, constant: 16),
            root.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -16),
            root.topAnchor.constraint(equalTo: content.topAnchor, constant: 16),
            root.bottomAnchor.constraint(equalTo: content.bottomAnchor, constant: -16),
            scroll.heightAnchor.constraint(greaterThanOrEqualToConstant: 480),
            spacer.widthAnchor.constraint(greaterThanOrEqualToConstant: 20)
        ])
    }

    @objc private func refreshTapped() { load() }

    private func load() {
        summaryLabel.stringValue = "加载候选需求..."
        clearCards()
        runWJAsync(["requirements", "payload", "--date", day]) { [weak self] result in
            guard let self else { return }
            guard result.ok else {
                self.summaryLabel.stringValue = "加载失败：\(result.message)"
                return
            }
            do {
                let payload = try parseObject(result.stdout)
                self.render(payload)
            } catch {
                self.summaryLabel.stringValue = "解析失败：\(error.localizedDescription)"
            }
        }
    }

    private func render(_ payload: [String: Any]) {
        clearCards()
        let summary = object(payload["summary"])
        let candidates = list(payload["candidates"]).compactMap { $0 as? [String: Any] }
        summaryLabel.stringValue = "候选 \(int(summary["total_candidates"], default: candidates.count)) 个，待确认 \(int(summary["pending_candidates"], default: 0)) 个，事件 \(int(summary["event_count"], default: 0)) 条"
        if candidates.isEmpty {
            stack.addArrangedSubview(makeLabel("今天没有待确认需求。"))
            return
        }
        for candidate in candidates {
            let card = ReviewCardView(candidate: candidate)
            cards.append(card)
            stack.addArrangedSubview(card)
        }
    }

    private func clearCards() {
        cards.removeAll()
        for view in stack.arrangedSubviews {
            stack.removeArrangedSubview(view)
            view.removeFromSuperview()
        }
    }

    @objc private func saveTapped() {
        let decisions = cards.map { $0.decision() }
        do {
            let input = try jsonString(["decisions": decisions])
            summaryLabel.stringValue = "保存中..."
            runWJAsync(["requirements", "save", "--date", day], input: input) { [weak self] result in
                guard let self else { return }
                if result.ok {
                    self.onSaved()
                    self.summaryLabel.stringValue = "已保存"
                    self.load()
                } else {
                    self.summaryLabel.stringValue = "保存失败：\(result.message)"
                }
            }
        } catch {
            summaryLabel.stringValue = "保存失败：\(error.localizedDescription)"
        }
    }
}

final class ReviewCardView: NSBox {
    private let candidate: [String: Any]
    private let titleField = makeField()
    private let statusPopup = NSPopUpButton()
    private let typePopup = NSPopUpButton()

    init(candidate: [String: Any]) {
        self.candidate = candidate
        super.init(frame: .zero)
        boxType = .custom
        borderWidth = 1
        borderColor = .separatorColor
        fillColor = .controlBackgroundColor
        cornerRadius = 8
        contentViewMargins = NSSize(width: 12, height: 12)
        build()
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }

    private func build() {
        guard let content = contentView else { return }
        let root = NSStackView()
        root.orientation = .vertical
        root.spacing = 8
        root.translatesAutoresizingMaskIntoConstraints = false
        content.addSubview(root)

        titleField.stringValue = text(candidate["title"])
        root.addArrangedSubview(makeLabel("需求标题", weight: .medium))
        root.addArrangedSubview(titleField)

        let meta = makeLabel("\(text(candidate["project"])) · \(text(candidate["requirement_type"])) · 置信度 \(text(candidate["confidence"])) · 事件 \(text(candidate["event_count"]))")
        meta.textColor = .secondaryLabelColor
        root.addArrangedSubview(meta)

        let controls = NSStackView()
        controls.orientation = .horizontal
        controls.spacing = 8
        statusPopup.addItems(withTitles: ["confirmed", "pending", "ignored"])
        statusPopup.selectItem(withTitle: text(candidate["status"]).isEmpty ? "pending" : text(candidate["status"]))
        typePopup.addItems(withTitles: ["direct", "plan-driven", "review", "debug", "docs"])
        typePopup.selectItem(withTitle: text(candidate["requirement_type"]).isEmpty ? "direct" : text(candidate["requirement_type"]))
        controls.addArrangedSubview(makeLabel("状态"))
        controls.addArrangedSubview(statusPopup)
        controls.addArrangedSubview(makeLabel("类型"))
        controls.addArrangedSubview(typePopup)
        root.addArrangedSubview(controls)

        let reasons = list(candidate["reasons"]).map { text($0) }.filter { !$0.isEmpty }.joined(separator: "；")
        if !reasons.isEmpty {
            let reasonLabel = makeLabel(reasons)
            reasonLabel.textColor = .systemOrange
            root.addArrangedSubview(reasonLabel)
        }

        let request = text(candidate["request"])
        if !request.isEmpty {
            let requestLabel = makeLabel(request)
            requestLabel.maximumNumberOfLines = 3
            root.addArrangedSubview(requestLabel)
        }

        let files = list(candidate["files"]).prefix(4).map { text($0) }.filter { !$0.isEmpty }.joined(separator: "\n")
        if !files.isEmpty {
            let filesLabel = makeLabel(files)
            filesLabel.textColor = .secondaryLabelColor
            filesLabel.maximumNumberOfLines = 4
            root.addArrangedSubview(filesLabel)
        }

        NSLayoutConstraint.activate([
            root.leadingAnchor.constraint(equalTo: content.leadingAnchor),
            root.trailingAnchor.constraint(equalTo: content.trailingAnchor),
            root.topAnchor.constraint(equalTo: content.topAnchor),
            root.bottomAnchor.constraint(equalTo: content.bottomAnchor),
            titleField.widthAnchor.constraint(greaterThanOrEqualToConstant: 560)
        ])
    }

    func decision() -> [String: Any] {
        return [
            "candidate_id": text(candidate["candidate_id"]),
            "title": titleField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines),
            "project": text(candidate["project"]),
            "requirement_type": typePopup.titleOfSelectedItem ?? "direct",
            "status": statusPopup.titleOfSelectedItem ?? "pending",
            "event_ids": list(candidate["event_ids"]),
            "anchors": object(candidate["anchors"])
        ]
    }
}

final class SettingsWindowController: NSWindowController {
    private var payload: [String: Any] = [:]
    private let statusLabel = makeLabel("加载中...")
    private let configPathField = makeField()
    private let inboxField = makeField()
    private let outputField = makeField()
    private let vaultField = makeField()
    private let dailyField = makeField()
    private let taskField = makeField()
    private let aiEnabled = NSButton(checkboxWithTitle: "启用 DeepSeek 分析", target: nil, action: nil)
    private let aiModelField = makeField()
    private let aiTimeoutField = makeField()
    private let apiKeyField = NSSecureTextField()
    private let codexEnabled = NSButton(checkboxWithTitle: "启用 Codex 采集", target: nil, action: nil)
    private let codexRootField = makeField()
    private let claudeEnabled = NSButton(checkboxWithTitle: "启用 Claude 采集", target: nil, action: nil)
    private let claudeSettingsField = makeField()
    private let opencodeEnabled = NSButton(checkboxWithTitle: "启用 OpenCode 采集", target: nil, action: nil)
    private let opencodeStorageField = makeField()
    private let opencodePluginField = makeField()

    init() {
        let window = NSWindow(
            contentRect: NSRect(x: 0, y: 0, width: 760, height: 700),
            styleMask: [.titled, .closable, .resizable],
            backing: .buffered,
            defer: false
        )
        window.title = "Work Journal 设置"
        super.init(window: window)
        build()
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }

    func show() {
        window?.center()
        window?.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        load()
    }

    private func build() {
        guard let content = window?.contentView else { return }
        let root = NSStackView()
        root.orientation = .vertical
        root.spacing = 10
        root.translatesAutoresizingMaskIntoConstraints = false
        content.addSubview(root)

        let header = NSStackView()
        header.orientation = .horizontal
        header.alignment = .centerY
        header.addArrangedSubview(makeLabel("设置", weight: .semibold))
        header.addArrangedSubview(NSView())
        header.addArrangedSubview(NSButton(title: "重新加载", target: self, action: #selector(loadTapped)))
        header.addArrangedSubview(NSButton(title: "保存", target: self, action: #selector(saveTapped)))
        root.addArrangedSubview(header)
        root.addArrangedSubview(statusLabel)

        let scroll = NSScrollView()
        scroll.hasVerticalScroller = true
        let form = NSStackView()
        form.orientation = .vertical
        form.spacing = 12
        form.edgeInsets = NSEdgeInsets(top: 4, left: 2, bottom: 16, right: 8)
        attachDocumentView(form, to: scroll)
        root.addArrangedSubview(scroll)

        addField(form, "配置文件", configPathField)
        addSection(form, "存储")
        addField(form, "事件 inbox", inboxField)
        addField(form, "备用输出目录", outputField)
        addSection(form, "Obsidian")
        addField(form, "Vault 根目录", vaultField)
        addField(form, "Daily 目录", dailyField)
        addField(form, "Tasks 目录", taskField)
        addSection(form, "DeepSeek")
        form.addArrangedSubview(aiEnabled)
        addField(form, "模型", aiModelField)
        addField(form, "超时秒数", aiTimeoutField)
        apiKeyField.placeholderString = "留空表示不修改已有 Key"
        addField(form, "API Key", apiKeyField)
        addSection(form, "采集源")
        form.addArrangedSubview(codexEnabled)
        addField(form, "Codex sessions", codexRootField)
        form.addArrangedSubview(claudeEnabled)
        addField(form, "Claude settings.json", claudeSettingsField)
        form.addArrangedSubview(opencodeEnabled)
        addField(form, "OpenCode storage", opencodeStorageField)
        addField(form, "OpenCode plugin", opencodePluginField)

        NSLayoutConstraint.activate([
            root.leadingAnchor.constraint(equalTo: content.leadingAnchor, constant: 16),
            root.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -16),
            root.topAnchor.constraint(equalTo: content.topAnchor, constant: 16),
            root.bottomAnchor.constraint(equalTo: content.bottomAnchor, constant: -16),
            scroll.heightAnchor.constraint(greaterThanOrEqualToConstant: 560)
        ])
    }

    private func addSection(_ stack: NSStackView, _ title: String) {
        let label = makeLabel(title, weight: .semibold)
        label.font = NSFont.systemFont(ofSize: 15, weight: .semibold)
        stack.addArrangedSubview(label)
    }

    private func addField(_ stack: NSStackView, _ title: String, _ field: NSTextField) {
        let row = NSStackView()
        row.orientation = .horizontal
        row.spacing = 10
        let label = makeLabel(title)
        label.widthAnchor.constraint(equalToConstant: 132).isActive = true
        row.addArrangedSubview(label)
        row.addArrangedSubview(field)
        field.widthAnchor.constraint(greaterThanOrEqualToConstant: 460).isActive = true
        stack.addArrangedSubview(row)
    }

    @objc private func loadTapped() { load() }

    private func load() {
        statusLabel.stringValue = "加载配置..."
        runWJAsync(["app", "config"]) { [weak self] result in
            guard let self else { return }
            guard result.ok else {
                self.statusLabel.stringValue = "加载失败：\(result.message)"
                return
            }
            do {
                self.payload = try parseObject(result.stdout)
                self.fill(self.payload)
                self.statusLabel.stringValue = "配置已加载"
            } catch {
                self.statusLabel.stringValue = "解析失败：\(error.localizedDescription)"
            }
        }
    }

    private func fill(_ payload: [String: Any]) {
        configPathField.stringValue = text(payload["config_path"])
        let storage = object(payload["storage"])
        let obsidian = object(payload["obsidian"])
        let ai = object(payload["ai"])
        let sources = object(payload["sources"])
        let codex = object(sources["codex"])
        let claude = object(sources["claude"])
        let opencode = object(sources["opencode"])

        inboxField.stringValue = text(storage["inbox_path"])
        outputField.stringValue = text(storage["output_dir"])
        vaultField.stringValue = text(obsidian["vault_path"])
        dailyField.stringValue = text(obsidian["daily_dir"])
        taskField.stringValue = text(obsidian["task_dir"])
        aiEnabled.state = bool(ai["enabled"]) ? .on : .off
        aiModelField.stringValue = text(ai["model"])
        aiTimeoutField.stringValue = text(ai["timeout_seconds"])
        apiKeyField.stringValue = ""
        codexEnabled.state = bool(codex["enabled"]) ? .on : .off
        codexRootField.stringValue = text(codex["sessions_root"])
        claudeEnabled.state = bool(claude["enabled"]) ? .on : .off
        claudeSettingsField.stringValue = text(claude["settings_path"])
        opencodeEnabled.state = bool(opencode["enabled"]) ? .on : .off
        opencodeStorageField.stringValue = text(opencode["storage_root"])
        opencodePluginField.stringValue = text(opencode["plugin_path"])
    }

    @objc private func saveTapped() {
        let existingObsidian = object(payload["obsidian"])
        let existingAi = object(payload["ai"])
        var ai: [String: Any] = [
            "enabled": aiEnabled.state == .on,
            "model": aiModelField.stringValue,
            "timeout_seconds": Int(aiTimeoutField.stringValue) ?? 120,
            "cache_enabled": bool(existingAi["cache_enabled"], default: true),
            "cache_retention_days": int(existingAi["cache_retention_days"], default: 7),
            "cluster_review_enabled": bool(existingAi["cluster_review_enabled"], default: true),
            "cluster_review_min_confidence": existingAi["cluster_review_min_confidence"] ?? 0.75,
            "knowledge_enabled": bool(existingAi["knowledge_enabled"], default: false)
        ]
        if !apiKeyField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
            ai["api_key"] = apiKeyField.stringValue
        }
        let config: [String: Any] = [
            "config_path": configPathField.stringValue,
            "storage": [
                "inbox_path": inboxField.stringValue,
                "output_dir": outputField.stringValue
            ],
            "obsidian": [
                "vault_path": vaultField.stringValue,
                "daily_dir": dailyField.stringValue,
                "task_dir": taskField.stringValue,
                "write_task_notes": bool(existingObsidian["write_task_notes"], default: false),
                "knowledge_dir": text(existingObsidian["knowledge_dir"]).isEmpty ? "Knowledge" : text(existingObsidian["knowledge_dir"]),
                "write_knowledge_notes": bool(existingObsidian["write_knowledge_notes"], default: false)
            ],
            "ai": ai,
            "sources": [
                "codex": [
                    "enabled": codexEnabled.state == .on,
                    "sessions_root": codexRootField.stringValue
                ],
                "claude": [
                    "enabled": claudeEnabled.state == .on,
                    "settings_path": claudeSettingsField.stringValue
                ],
                "opencode": [
                    "enabled": opencodeEnabled.state == .on,
                    "storage_root": opencodeStorageField.stringValue,
                    "plugin_path": opencodePluginField.stringValue
                ]
            ]
        ]
        do {
            let input = try jsonString(config)
            statusLabel.stringValue = "保存中..."
            runWJAsync(["app", "config-save"], input: input) { [weak self] result in
                guard let self else { return }
                if result.ok {
                    self.statusLabel.stringValue = "配置已保存"
                    self.apiKeyField.stringValue = ""
                    if let payload = try? parseObject(result.stdout) {
                        self.payload = payload
                        self.fill(payload)
                    }
                } else {
                    self.statusLabel.stringValue = "保存失败：\(result.message)"
                }
            }
        } catch {
            statusLabel.stringValue = "保存失败：\(error.localizedDescription)"
        }
    }
}

let app = NSApplication.shared
let delegate = AppDelegate()
app.delegate = delegate
app.setActivationPolicy(.accessory)
app.run()
